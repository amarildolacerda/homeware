{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GIT_TOKEN}"
      }
    }
  },
  "permission": {
    "bash": {
      "git *": "allow",
      "gh *": "allow",
      "platformio *": "allow",
      "python *": "allow",
      "*": "ask"
    },
    "edit": "allow",
    "external_directory": {
      "~/*": "allow"
    }
  }
}
